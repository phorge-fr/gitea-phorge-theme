{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home_title"}}{{end}}" class="page-content home">
	<div class="tw-mb-8 tw-px-8">
		<div class="center">
			<img class="logo" width="220" height="220" src="{{AssetUrlPrefix}}/img/logo.svg" alt="{{ctx.Locale.Tr "logo"}}">
			<div class="hero">
				<h1 class="ui icon header title tw-text-balance">
					{{AppName}}
				</h1>
				<h2 class="tw-text-balance">Easy to use git service for all your φorge work</h2>
			</div>
		</div>
	</div>
	<div class="ui stackable middle very relaxed page grid">
		<div class="eight wide center column">
			<h1 class="hero ui icon header">
				{{svg "octicon-cloud"}} Simple
			</h1>
			<p class="large tw-text-balance">
				Integrates easily with all <a target="_blank" rel="noopener noreferrer" href="https://phorge.fr">φorge</a> services & apps !
			</p>
		</div>
		<div class="eight wide center column">
			<h1 class="hero ui icon header">
				{{svg "octicon-ai-model"}} CI/CD Ready
			</h1>
			<p class="large tw-text-balance">
				Orchestrate jobs & workflows quickly on all the available resources on our infrastructure !
			</p>
		</div>
	</div>
	<div class="ui stackable middle very relaxed page grid">
		<div class="eight wide center column">
			<h1 class="hero ui icon header">
				{{svg "octicon-gear"}} Modern
			</h1>
			<p class="large tw-text-balance">
				Work with some of the most used and recognized tools in the cloud community !
			</p>
		</div>
		<div class="eight wide center column">
			<h1 class="hero ui icon header">
				{{svg "octicon-code"}} Open Source
			</h1>
			<p class="large tw-text-balance">
				Every tools and configurations are free, open-source and <a target="_blank" rel="noopener noreferrer" href="https://github.com/phorge-fr">publicly available</a> !
			</p>
		</div>
	</div>
</div>
{{template "base/footer" .}}